# ====== À COPIER/ADAPTER DANS LE FICHIER .env DE LARAVEL (XAMPP) ======
APP_NAME=ECATIC
APP_ENV=local
APP_DEBUG=true            # METTRE false EN PRODUCTION
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecatic
DB_USERNAME=root          # XAMPP : root
DB_PASSWORD=              # XAMPP : mot de passe vide par défaut (à changer en production !)

SESSION_DRIVER=database
CACHE_STORE=database

# Compte administrateur créé par le seeder (choisissez un mot de passe FORT)
ADMIN_NAME="Administrateur ECATIC"
ADMIN_EMAIL=admin@ecatic.sn
ADMIN_PASSWORD=

