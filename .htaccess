<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve files from public/ when Hostinger keeps this repository
    # in the web root instead of configuring public/ as DocumentRoot.
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # Redirect direct access to public/ and route Laravel requests.
    RewriteCond %{THE_REQUEST} /public/ [NC]
    RewriteRule ^public/(.*)$ /$1 [R=301,L,NE]

    RewriteRule ^$ public/index.php [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ public/index.php [L]
</IfModule>
